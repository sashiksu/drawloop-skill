{
  "name": "drawloop-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Claude Code skill that opens a local Excalidraw editor for bidirectional diagram editing.",
  "homepage": "https://sashiksu.github.io/drawloop-skill/",
  "repository": { "type": "git", "url": "https://github.com/sashiksu/drawloop-skill.git" },
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build:ui": "cd ui && npm run build",
    "test": "vitest run",
    "check": "biome check . && tsc --noEmit && vitest run",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@excalidraw/mermaid-to-excalidraw": "^1.1.2",
    "@excalidraw/utils": "^0.1.2",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
