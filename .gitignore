# Claude Code per-project settings (personal allow list, machine-local)
.claude/settings.local.json

# Build artifacts
node_modules/
ui/dist/
*.tsbuildinfo

# Icon cache (regenerated on demand)
icons/cache/

# Snapshots (per-user, never committed)
*.bak-*
*.excalidraw.bak-*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Docs — local working notes (specs, plans, drafts) live in docs/ but should
# never be committed. Only the README's architecture image is allow-listed.
# Pattern: ignore contents of docs/, then re-include the architecture path
# step by step (you can't re-include a file whose parent dir is ignored).
docs/*
!docs/architecture/
docs/architecture/*
!docs/architecture/architecture.png
